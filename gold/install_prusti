#! /bin/bash
set -e

requires \
    awk \
    cargo \
    cat \
    git \
    grep \
    java \
    mktemp \
    python3
main() {
    #
    # Install Prusti crate
    #
    local SRC_DIRECTORY="${HOME}/prusti"
    git clone https://github.com/viperproject/prusti-dev.git "${SRC_DIRECTORY}"
    pushd "${SRC_DIRECTORY}" > /dev/null || exit
    ./x.py setup && ./x.py build --release
    mkdir -p "${HOME}/.local/bin"
    mv "${SRC_DIRECTORY}/target/release/prusti-rustc" "${HOME}/.local/bin/"
    mv "${SRC_DIRECTORY}/target/release/cargo-prusti" "${HOME}/.local/bin/"
    chmod +x "${HOME}/.local/bin/prusti-rustc"
    chmod +x "${HOME}/.local/bin/cargo-prusti"
    # shellcheck disable=SC2016
    local OLD_PATH_LINE='export PATH="${HOME}/prusti/bin:${PATH}"'
    if [[ -f "${HOME}/.zshrc" ]] && grep -Fqx "${OLD_PATH_LINE}" "${HOME}/.zshrc"; then
        local PROFILE_TMP
        PROFILE_TMP="$(mktemp "${HOME}/.zshrc.XXXXXX")"
        awk -v old="${OLD_PATH_LINE}" '$0 != old' "${HOME}/.zshrc" > "${PROFILE_TMP}"
        cat "${PROFILE_TMP}" > "${HOME}/.zshrc"
        rm -f "${PROFILE_TMP}"
    fi
    # shellcheck disable=SC2016
    local PATH_LINE='case ":${PATH}:" in *":${HOME}/.local/bin:"*) ;; *) export PATH="${HOME}/.local/bin:${PATH}" ;; esac'
    if ! grep -Fqx "${PATH_LINE}" "${HOME}/.zshrc" 2> /dev/null; then
        printf '%s\n' "${PATH_LINE}" >> "${HOME}/.zshrc"
    fi
    if [[ ":${PATH}:" != *":${HOME}/.local/bin:"* ]]; then
        export PATH="${HOME}/.local/bin:${PATH}"
    fi
    popd > /dev/null || exit
    rm -rf "${SRC_DIRECTORY}"
}
main "$@"
