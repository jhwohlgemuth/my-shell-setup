#! /bin/bash
set -e

requires \
    append_if_missing \
    curl \
    id \
    uname \
    zsh
main() {
    local ARCH
    local CUDA_HOME_LINE
    local CUDA_HOME_DIR="${1:-/usr/local/cuda}"
    # shellcheck disable=SC2016
    local CUDA_PATH_LINE='export PATH=${CUDA_HOME}/bin:${PATH}'
    local DEBIAN_VERSION
    local DISTRO_ID
    local OS
    local OS_RELEASE_FILE="${OS_RELEASE_FILE:-/etc/os-release}"
    # shellcheck disable=SC2016
    local LD_LIBRARY_PATH_LINE='export LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}'
    local TARGET_HOME
    local ZSHRC
    OS="$(uname -s)"
    ARCH="$(uname -m)"
    if [[ ! -r "${OS_RELEASE_FILE}" ]]; then
        printf '==> [ERROR] CUDA toolkit installer requires a readable os-release file at %s\n' "${OS_RELEASE_FILE}" >&2
        return 1
    fi
    DISTRO_ID="$(awk -F= '$1 == "ID" {gsub(/"/, "", $2); print $2}' "${OS_RELEASE_FILE}")"
    DEBIAN_VERSION="$(awk -F= '$1 == "VERSION_ID" {gsub(/"/, "", $2); split($2, version_parts, "."); print version_parts[1]}' "${OS_RELEASE_FILE}")"
    if [[ "${OS}" != Linux || "${ARCH}" != x86_64 || "${DISTRO_ID}" != debian || -z "${DEBIAN_VERSION}" || "$(id -u)" != 0 ]]; then
        printf '==> [ERROR] CUDA toolkit installer supports Debian Linux x86-64 as root, detected %s %s %s %s uid=%s\n' \
            "${DISTRO_ID:-unknown}" "${DEBIAN_VERSION:-unknown}" "${OS}" "${ARCH}" "$(id -u)" >&2
        return 1
    fi
    if [[ -n "${SUDO_USER:-}" ]]; then
        TARGET_HOME="$(getent passwd "${SUDO_USER}" | awk -F: '{print $6}')"
    fi
    TARGET_HOME="${TARGET_HOME:-/home/nonroot}"
    ZSHRC="${TARGET_HOME}/.zshrc"
    curl -fsSL \
        "https://developer.download.nvidia.com/compute/cuda/repos/debian${DEBIAN_VERSION}/x86_64/cuda-keyring_1.1-1_all.deb" \
        -o cuda-keyring_1.1-1_all.deb
    sudo dpkg -i cuda-keyring_1.1-1_all.deb
    rm cuda-keyring_1.1-1_all.deb
    apt-get update
    apt-get install --yes cuda-toolkit
    CUDA_HOME_LINE="export CUDA_HOME=${CUDA_HOME_DIR}"
    append_if_missing "${CUDA_HOME_LINE}" "${ZSHRC}"
    append_if_missing "${CUDA_PATH_LINE}" "${ZSHRC}"
    append_if_missing "${LD_LIBRARY_PATH_LINE}" "${ZSHRC}"
    printf "\n=> [WARNING] Run 'source %s' or restart your shell to apply PATH changes\n" "${ZSHRC}"
}
main "$@"
