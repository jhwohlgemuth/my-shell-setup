#! /bin/bash
set -e

requires \
    curl \
    jq
main() {
    local ARG NAMESPACE EXTENSION RESPONSE URL
    if [[ "$#" -eq 0 ]]; then
        printf 'Usage: %s <publisher.extension>...\n' "$(basename "$0")" >&2
        return 2
    fi
    for ARG in "$@"; do
        if [[ ! "${ARG}" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*\.[A-Za-z0-9][A-Za-z0-9_-]*$ ]]; then
            printf 'Invalid extension ID: %s\n' "${ARG}" >&2
            return 2
        fi
        NAMESPACE="${ARG%%.*}"
        EXTENSION="${ARG#*.}"
        RESPONSE="$(curl -fsSL -- "https://open-vsx.org/api/${NAMESPACE}/${EXTENSION}")"
        URL="$(jq -er '.downloads.universal | select(type == "string" and startswith("https://"))' <<< "${RESPONSE}")"
        curl -fsSL --output "${ARG}.vsix" -- "${URL}"
    done
}
main "$@"
