#! /bin/bash
set -e

requires \
    append_if_missing \
    curl \
    mktemp \
    shasum \
    tar \
    uname
verify_sha256() {
    local FILE="${1}"
    local EXPECTED="${2}"
    printf '%s  %s\n' "${EXPECTED}" "${FILE}" | shasum -a 256 --check --status
}
download_verified() {
    local URL="${1}"
    local EXPECTED="${2}"
    local OUTPUT="${3}"
    curl --fail --location --silent --show-error --output "${OUTPUT}" "${URL}"
    verify_sha256 "${OUTPUT}" "${EXPECTED}"
}
main() {
    local MOONBIT_VERSION='0.10.19+bee578715'
    local MOONBIT_URL_VERSION='0.10.19%2Bbee578715'
    local MOONBIT_ARCHIVE_SHA256='dd1d6d793c9675405ef32b39bce66d40041e2052a9c3f2f403e0a9da98bd94fd'
    local MOONBIT_CORE_SHA256='b5b33afc759b8ae332346f357f42235d4c8d54afd91bb891b22ead3d746fa74f'
    local MOONBIT_ARCHIVE_URL="https://cli.moonbitlang.com/binaries/${MOONBIT_URL_VERSION}/moonbit-linux-x86_64.tar.gz"
    local MOONBIT_CORE_URL="https://cli.moonbitlang.com/cores/core-${MOONBIT_URL_VERSION}.tar.gz"
    local MOONBIT_HOME="${MOON_HOME:-${HOME}/.moon}"
    local MOONBIT_BIN="${MOONBIT_HOME}/bin/moon"
    local MOONBIT_PATH_LINE="export PATH=\"${MOONBIT_HOME}/bin:\${PATH}\""
    local MOONBIT_TEMP_DIRECTORY
    local OS ARCH
    OS="$(uname -s)"
    ARCH="$(uname -m)"
    if [[ "${OS}" != Linux || "${ARCH}" != x86_64 ]]; then
        printf '==> [ERROR] MoonBit %s installer supports Linux x86-64, detected %s %s\n' "${MOONBIT_VERSION}" "${OS}" "${ARCH}" >&2
        return 1
    fi
    MOONBIT_TEMP_DIRECTORY="$(mktemp -d "${TMPDIR:-/tmp}/install_moonbit-${MOONBIT_VERSION}.XXXXXX")"
    trap 'rm -rf -- "${MOONBIT_TEMP_DIRECTORY}"' EXIT
    download_verified "${MOONBIT_ARCHIVE_URL}" "${MOONBIT_ARCHIVE_SHA256}" "${MOONBIT_TEMP_DIRECTORY}/moonbit.tar.gz"
    download_verified "${MOONBIT_CORE_URL}" "${MOONBIT_CORE_SHA256}" "${MOONBIT_TEMP_DIRECTORY}/core.tar.gz"
    mkdir -p "${MOONBIT_HOME}"
    rm -rf -- "${MOONBIT_HOME:?}/lib" "${MOONBIT_HOME:?}/include"
    tar -xf "${MOONBIT_TEMP_DIRECTORY}/moonbit.tar.gz" --directory="${MOONBIT_HOME}"
    ln -sfn moon "${MOONBIT_HOME}/bin/moonx"
    find "${MOONBIT_HOME}/bin" -type f -exec chmod +x {} +
    chmod +x "${MOONBIT_HOME}/bin/internal/tcc"
    rm -rf -- "${MOONBIT_HOME:?}/lib/core"
    tar -xf "${MOONBIT_TEMP_DIRECTORY}/core.tar.gz" --directory="${MOONBIT_HOME}/lib"
    PATH="${MOONBIT_HOME}/bin:${PATH}" "${MOONBIT_BIN}" -C "${MOONBIT_HOME}/lib/core" bundle --warn-list -a --all
    PATH="${MOONBIT_HOME}/bin:${PATH}" "${MOONBIT_BIN}" -C "${MOONBIT_HOME}/lib/core" bundle --warn-list -a --target wasm-gc --quiet
    append_if_missing "${MOONBIT_PATH_LINE}" "${HOME}/.zshrc"
    export PATH="${MOONBIT_HOME}/bin:${PATH}"
    rm -rf -- "${MOONBIT_TEMP_DIRECTORY}"
    trap - EXIT
}
main "$@"
