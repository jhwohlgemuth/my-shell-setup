install_moonbit() {
    local MOONBIT_VERSION='0.10.19+bee578715'
    local MOONBIT_URL_VERSION='0.10.19%2Bbee578715'
    local MOONBIT_ARCHIVE_SHA256='dd1d6d793c9675405ef32b39bce66d40041e2052a9c3f2f403e0a9da98bd94fd'
    local MOONBIT_CORE_SHA256='b5b33afc759b8ae332346f357f42235d4c8d54afd91bb891b22ead3d746fa74f'
    local MOONBIT_ARCHIVE_URL="https://cli.moonbitlang.com/binaries/${MOONBIT_URL_VERSION}/moonbit-linux-x86_64.tar.gz"
    local MOONBIT_CORE_URL="https://cli.moonbitlang.com/cores/core-${MOONBIT_URL_VERSION}.tar.gz"
    local MOONBIT_HOME="${MOON_HOME:-${HOME}/.moon}"
    local MOONBIT_BIN="${MOONBIT_HOME}/bin/moon"
    local MOONBIT_PATH_LINE="export PATH=\"${MOONBIT_HOME}/bin:\${PATH}\""
    local MOONBIT_TEMP_DIRECTORY
    local OS ARCH
    OS="$(uname -s)"
    ARCH="$(uname -m)"
    if [[ "${OS}" != Linux || "${ARCH}" != x86_64 ]]; then
        printf '==> [ERROR] MoonBit %s installer supports Linux x86-64, detected %s %s\n' "${MOONBIT_VERSION}" "${OS}" "${ARCH}" >&2
        return 1
    fi
    MOONBIT_TEMP_DIRECTORY="$(mktemp -d "${TMPDIR:-/tmp}/install_moonbit-${MOONBIT_VERSION}.XXXXXX")"
    trap 'rm -rf -- "${MOONBIT_TEMP_DIRECTORY}"' EXIT
    download_verified "${MOONBIT_ARCHIVE_URL}" "${MOONBIT_ARCHIVE_SHA256}" "${MOONBIT_TEMP_DIRECTORY}/moonbit.tar.gz"
    download_verified "${MOONBIT_CORE_URL}" "${MOONBIT_CORE_SHA256}" "${MOONBIT_TEMP_DIRECTORY}/core.tar.gz"
    mkdir -p "${MOONBIT_HOME}"
    rm -rf -- "${MOONBIT_HOME:?}/lib" "${MOONBIT_HOME:?}/include"
    tar -xf "${MOONBIT_TEMP_DIRECTORY}/moonbit.tar.gz" --directory="${MOONBIT_HOME}"
    ln -sfn moon "${MOONBIT_HOME}/bin/moonx"
    find "${MOONBIT_HOME}/bin" -type f -exec chmod +x {} +
    chmod +x "${MOONBIT_HOME}/bin/internal/tcc"
    rm -rf -- "${MOONBIT_HOME:?}/lib/core"
    tar -xf "${MOONBIT_TEMP_DIRECTORY}/core.tar.gz" --directory="${MOONBIT_HOME}/lib"
    PATH="${MOONBIT_HOME}/bin:${PATH}" "${MOONBIT_BIN}" -C "${MOONBIT_HOME}/lib/core" bundle --warn-list -a --all
    PATH="${MOONBIT_HOME}/bin:${PATH}" "${MOONBIT_BIN}" -C "${MOONBIT_HOME}/lib/core" bundle --warn-list -a --target wasm-gc --quiet
    append_if_missing "${MOONBIT_PATH_LINE}" "${HOME}/.zshrc"
    export PATH="${MOONBIT_HOME}/bin:${PATH}"
    rm -rf -- "${MOONBIT_TEMP_DIRECTORY}"
    trap - EXIT
}
install_emscripten() {
    local EMSDK_ENV_LINE="source \"${EMSDK_DIRECTORY}/emsdk_env.sh\""
    #
    # Install Emscripten tools (emsdk and emcc)
    #
    git clone https://github.com/emscripten-core/emsdk.git "${EMSDK_DIRECTORY}"
    cd "${EMSDK_DIRECTORY}" || exit
    ./emsdk install latest
    ./emsdk activate latest
    echo "$(gum style --foreground 46 '🗸') Installed $(gum style --foreground 46 Emscripten)"
    append_if_missing 'export EMSDK_QUIET=1' "${HOME}/.zshrc"
    append_if_missing "${EMSDK_ENV_LINE}" "${HOME}/.zshrc"
    cd "${HOME}" || exit
}
install_rust_targets_and_tools() {
    #
    # Install Rust WASM/WASI targets and tools
    #
    gum spin --title 'Adding WASM Unknown target' -- rustup target add wasm32-unknown-unknown
    gum spin --title 'Adding WASI (preview 1) target' -- rustup target add wasm32-wasip1
    gum spin --title 'Adding WASI (preview 2) target' -- rustup target add wasm32-wasip2
    gum spin --title 'Installing WASM/WASI related crates' -- cargo install \
        cargo-wasi \
        cargo-wasix \
        wasm-bindgen-cli \
        wasm-pack \
        wasm-tools
}
under_construction() {
    local CHOICE="${1:-''}"
    echo "> :construction: Please pardon our dust. Installing ${CHOICE} is still under construction." | gum format -t emoji
}
complete() {
    local CHOICE="${1:-''}"
    echo "$(gum style --foreground 46 '🗸') Installed $(gum style --foreground 46 "${CHOICE}")"
    echo -e '\n> Make new commands available in this shell by running `source ~/.zshrc`\n' | gum format
}
main() {
    local EMPTY="[ ] "
    local BIN_DIRECTORY="${1:-/usr/local/bin}"
    local COLOR="${GOLD_FOREGROUND_COLOR:-220}"
    local TITLE="$(gum style --foreground "${COLOR}" 'Install') WASM tools & tech"
    local CHECKMARK="$(gum style --foreground 46 '🗸')"
    gum style \
        --border normal \
        --border-foreground "${COLOR}" \
        --margin "1" \
        --padding "1 2" \
        "${TITLE}"
    DATA="""
        Cosmonic:cosmo
        Emscripten:emcc
        MoonBit:moon
        Scale:scale
        Spin:spin
        WANIX:wanix
        waPC:apex
        Wasm3:wasm3
        WasmCloud:wash
        WasmEdge:wasmedge
        Wasmer:wasmer
        Wasmtime:wasmtime
        WAVM:wavm
        Wazero:wazero
        WEPL:wepl
        WWS:wws
    """
    COUNT=0
    MESSAGE=''
    for LINE in ${DATA}; do
        TECHNOLOGY=$(echo "${LINE}" | cut -d':' -f1)
        COMMAND=$(echo "${LINE}" | cut -d':' -f2)
        if is_command "${COMMAND}"; then
            COUNT=$((COUNT + 1))
            MESSAGE+="    ${CHECKMARK} ${TECHNOLOGY} ($(gum style --faint "${COMMAND}"))\n"
            DATA=$(echo "${DATA}" | sed "/${TECHNOLOGY}:${COMMAND}/d")
        fi
    done
    if [[ "${COUNT}" -gt 0 ]]; then
        echo 'The following are already {{ Color "46" "installed" }}' | gum format -t template
        echo -e "\n${MESSAGE}\n" | gum format -t template
    fi
    CHOICES=$(echo "${DATA}" | cut -d':' -f1)
    gum confirm 'Add Rust WASM targets and tools?' && install_rust_targets_and_tools
    # shellcheck disable=SC2046,SC2068,SC2116,SC2154
    CHOSEN=$(gum choose \
        --no-limit \
        --cursor-prefix="${EMPTY}" \
        --header="Please select items to install" \
        --selected.foreground="${COLOR}" \
        --selected-prefix="[X] " \
        --unselected-prefix="${EMPTY}" \
        $(echo "${CHOICES}"))
    for CHOICE in ${CHOSEN}; do
        case "${CHOICE}" in
            Cosmonic)
                install_cosmonic
                # shellcheck disable=SC2016
                append_if_missing 'export PATH="${HOME}/.cosmo/bin:${PATH}"' "${HOME}/.zshrc"
                export PATH="${HOME}/.cosmo/bin:${PATH}"
                complete "${CHOICE}"
                ;;
            Emscripten)
                install_emscripten
                # shellcheck disable=SC1091
                source "${EMSDK_DIRECTORY}/emsdk_env.sh"
                complete "${CHOICE}"
                ;;
            MoonBit)
                install_moonbit
                complete "${CHOICE}"
                ;;
            Scale)
                install_scale
                complete "${CHOICE}"
                ;;
            Spin)
                #
                # Spin microservices server (spin)
                #
                install_spin
                complete "${CHOICE}"
                ;;
            waPC)
                under_construction "${CHOICE}"
                ;;
            Wasm3)
                gum spin --title "(1 of 2) Installing Wasm3" -- brew install wasm3
                gum spin --title '(2 of 2) Performing Brew cleanup' -- brew cleanup --prune=all
                complete "${CHOICE}"
                ;;
            WasmCloud)
                #
                # WAsmCloud SHell (wash)
                #
                gum spin --title 'Updating package list' -- apt-get update
                curl -s https://packagecloud.io/install/repositories/wasmcloud/core/script.deb.sh | bash
                apt-get install --no-install-recommends -y wash
                cleanup
                complete "${CHOICE}"
                ;;
            WasmEdge)
                curl -sSf https://raw.githubusercontent.com/WasmEdge/WasmEdge/master/utils/install.sh | bash
                # shellcheck disable=SC2016
                append_if_missing '. "${HOME}/.wasmedge/env"' "${HOME}/.zshrc"
                # shellcheck disable=SC1091
                . "${HOME}/.wasmedge/env"
                complete "${CHOICE}"
                ;;
            Wasmer)
                gum spin --title "(1 of 3) Installing wapm" -- brew install wapm
                gum spin --title "(2 of 3) Installing wasmer (this can take a while...)" -- brew install wasmer
                gum spin --title '(3 of 3) Performing Brew cleanup' -- brew cleanup --prune=all
                complete "${CHOICE}"
                ;;
            Wasmtime)
                curl https://wasmtime.dev/install.sh -sSf | bash
                # shellcheck disable=SC2016
                append_if_missing 'export WASMTIME_HOME="${HOME}/.wasmtime"' "${HOME}/.zshrc"
                # shellcheck disable=SC2016
                append_if_missing 'export PATH="${WASMTIME_HOME}/bin:${PATH}"' "${HOME}/.zshrc"
                export WASMTIME_HOME="${HOME}/.wasmtime"
                export PATH="${WASMTIME_HOME}/bin:${PATH}"
                complete "${CHOICE}"
                ;;
            WAVM)
                local VERSION=${1:-"0.0.0-prerelease-linux"}
                local FILENAME='wavm.deb'
                cd /tmp || exit
                curl -o "${FILENAME}" -LJ "https://github.com/WAVM/WAVM/releases/download/nightly%2F2022-05-14/wavm-${VERSION}.deb"
                apt-get install -y "./${FILENAME}"
                rm "./${FILENAME}"
                cd "${HOME}" || exit
                complete "${CHOICE}"
                ;;
            Wazero)
                local INSTALL_DIRECTORY=./bin
                cd /tmp || exit
                curl https://wazero.io/install.sh | sh
                mv "${INSTALL_DIRECTORY}/wazero" "${BIN_DIRECTORY}"
                rm -frd "${INSTALL_DIRECTORY}"
                cd "${HOME}" || exit
                complete "${CHOICE}"
                ;;
            WANIX)
                #
                # Experimental, web-native, Unix-like operating and development environment
                #
                local INSTALL_DIRECTORY=/wanix
                gum spin --title "Cloning WANIX to ${INSTALL_DIRECTORY}" -- git clone https://github.com/tractordev/wanix.git "${INSTALL_DIRECTORY}"
                gum spin --title "Installing WANIX" -- bash -c "$(curl -sSL https://raw.githubusercontent.com/tractordev/wanix/main/install.sh)"
                echo -e '{{ Color "46" "wanix" }} command must be run from within {{ Color "6" "/wanix" }}\n' | gum format -t template
                cd "${INSTALL_DIRECTORY}" || exit
                complete "${CHOICE}"
                ;;
            WEPL)
                #
                # WebAssembly REPL
                #
                local INSTALL_DIRECTORY=/tmp/wepl
                git clone https://github.com/rylev/wepl "${INSTALL_DIRECTORY}"
                cd "${INSTALL_DIRECTORY}" || exit
                cargo install --path . --locked
                cd "${HOME}" || exit
                rm -frd "${INSTALL_DIRECTORY}"
                complete "${CHOICE}"
                ;;
            WWS)
                #
                # WASM workers server (wws)
                #
                cd "${BIN_DIRECTORY}" || exit
                curl -fsSL https://workers.wasmlabs.dev/install | bash -s -- --local
                cd "${HOME}" || exit
                complete "${CHOICE}"
                ;;
            *)
                exit 1
                ;;
        esac
    done
    echo ''
}
main "$@"
